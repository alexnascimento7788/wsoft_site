# Postgres connection string (Supabase: Project Settings > Database > Connection string > URI)
DATABASE_URI=postgresql://user:password@host:5432/database

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Supabase Storage (S3-compatible) - bucket "media" must be public
# Project Settings > Storage > S3 Connection
S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_REGION=us-west-2
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
